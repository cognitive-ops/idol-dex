# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-opus-4-8

# Vector backend: "faiss" (local file, default for dev) or "qdrant" (docker-compose)
VECTOR_BACKEND=faiss

# FAISS (used when VECTOR_BACKEND=faiss)
FAISS_INDEX_PATH=./data/faiss_index/index.faiss
METADATA_PATH=./data/metadata.json

# Qdrant (used when VECTOR_BACKEND=qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=imdb_docs

# Dataset download client
SCRAPER_TIMEOUT=30
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# IMDb non-commercial datasets (https://datasets.imdbws.com/)
IMDB_DATASET_BASE_URL=https://datasets.imdbws.com
IMDB_DATA_DIR=./data/imdb
IMDB_MAX_TITLES=300
IMDB_MIN_VOTES=10000
IMDB_CAST_PER_TITLE=5

# RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2
HF_HUB_DOWNLOAD_TIMEOUT=60
TOP_K=5
MAX_CONTEXT_LENGTH=3000

# API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend (streamlit -> backend). In docker-compose this is overridden to http://api:8000
API_BASE_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO
